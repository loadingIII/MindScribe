# MindScribe Docker 部署环境变量模板
# 使用方法：复制本文件为 .env，并替换为真实配置：cp .env.example .env

# ========== 主机端口映射（仅用于对外暴露端口，按需修改避免冲突） ==========
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=8081
ADMIN_PORT=8082
INFER_PORT=8000

# ========== MySQL ==========
# root 密码（MySQL 容器初始化与 Java 后端连接均使用 root 账号）
MYSQL_ROOT_PASSWORD=your_mysql_password
# 数据库名（首次启动容器时由 scripts/sql/mindscribe.sql 自动创建并导入数据）
MYSQL_DATABASE=mindscribe
# Java 后端连接账号
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# ========== Redis ==========
REDIS_PASSWORD=your_redis_password
# Java 后端使用的 Redis 逻辑库编号
REDIS_DATABASE=0

# ========== 提示词优化 LLM（Java 后端使用） ==========
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://your-llm-endpoint.example.com
LLM_API_NAME=your-llm-model-name

# ========== 图片生成服务（Python infer使用，OpenAI 兼容端点） ==========
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=your_openai_api_key

# ========== 阿里云 OSS ==========
# Java 后端使用的 Endpoint（带协议前缀）
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
# Python 图片生成服务使用的 Endpoint（不带协议前缀）
OSS_ENDPOINT_PYTHON=oss-cn-guangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=your_oss_bucket_name
OSS_REGION=cn-hangzhou
# 签名 URL 有效期（秒，Java 后端使用）
OSS_URL_EXPIRE_SECONDS=3600

# ========== JWT（生产环境务必更换为高强度随机密钥） ==========
JWT_SECRET=change-me-to-a-long-random-secret
