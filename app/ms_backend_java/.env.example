#MySQL 配置
MYSQL_PASSWORD=your_mysql_password
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/mindscribe?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=your_mysql_username

# 本地开发环境 OSS 配置；
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=your_oss_bucket_name

# redis 配置
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=your_redis_database
