<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ms.mapper.GenImgsMapper">

    <!-- 只更新传入的 Thread 字段；id 为空时不会命中任何记录。 -->
    <update id="updateThread" parameterType="com.ms.pojo.entity.ThreadEntity">
        UPDATE threads
        <set>
            updated_at = CURRENT_TIMESTAMP(3),
            <if test="title != null">title = #{title},</if>
            <if test="status != null">status = #{status},</if>
            <if test="attemptCount != null">attempt_count = #{attemptCount},</if>
            <if test="archivedAt != null">archived_at = #{archivedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 状态机更新通常只传 status/results/error/runtime/time 等字段。 -->
    <update id="updateAttempt" parameterType="com.ms.pojo.entity.AttemptEntity">
        UPDATE attempts
        <set>
            updated_at = CURRENT_TIMESTAMP(3),
            <if test="status != null">status = #{status},</if>
            <if test="results != null">results = #{results},</if>
            <if test="externalTaskId != null">external_task_id = #{externalTaskId},</if>
            <if test="errorCode != null">error_code = #{errorCode},</if>
            <if test="errorMessage != null">error_message = #{errorMessage},</if>
            <if test="runtimeMetadata != null">runtime_metadata = #{runtimeMetadata},</if>
            <if test="startedAt != null">started_at = #{startedAt},</if>
            <if test="finishedAt != null">finished_at = #{finishedAt},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
